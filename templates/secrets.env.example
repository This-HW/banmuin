# 비밀 설정 예시
# ------------------------------------------------------------------
# 실제 값을 절대 이 파일에 기입하지 말 것.
# 이 파일을 복사해 businesses/<slug>/secrets.env 로 저장한 뒤, 값은 Secure Vault에서 주입한다.
#   cp templates/secrets.env.example businesses/<slug>/secrets.env
# businesses/<slug>/secrets.env 는 .gitignore에 의해 Git에서 제외된다.
# 네이버 로그인은 Aside 세션을 사용하므로 비밀번호를 여기에 기록하지 않는다.
# ------------------------------------------------------------------

# 텔레그램 알림 (BotFather로 봇 생성 후 발급)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Meta (개발자 앱 + OAuth)
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
META_OAUTH_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Threads API
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Instagram Graph API (프로페셔널 계정 + Facebook 페이지 연결)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# YouTube Data API (프로젝트 감사 통과 필수)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Higgsfield (영상/이미지 생성)
HIGGSFIELD_API_KEY=
